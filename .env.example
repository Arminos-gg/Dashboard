# ── Claude ──────────────────────────────────────────────────────────────
# Enables AI quick-capture parsing and the daily briefing. Server-side only;
# never exposed to the browser. Without it Life/OS uses its local parser.
ANTHROPIC_API_KEY=
# Optional model override (default: claude-opus-5-5)
# ANTHROPIC_MODEL=claude-opus-5-5

# ── Supabase (optional cloud sync) ──────────────────────────────────────
# 1. Run supabase/migrations/0001_life_state.sql
# 2. Enable "Anonymous sign-ins" under Authentication → Sign In / Providers
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
